    "parts": {
      "similarity": {
        "": "Glyph of Similarity",
        "description": "The glyph of similarity transmutes a salt atom into any of the ordinals, based on the two input cardinals."
      },
      "stability": {
        "": "Glyph of Stability",
        "description": "The glyph of stability takes two ordinals, converting them into their shared cardinal."
      },
      "osmosis": {
        "": "Glyph of Osmosis",
        "description": "The glyph of osmosis accepts two adjacent metals, equalizing them to their opposite-order product."
      },
      "dissolution": {
        "": "Glyph of Dissolution",
        "description": "The glyph of dissolution accepts two of the same metal, diverging them to their nearest opposite-order pair."
      },
      "exchange": {
        "": "Glyph of Exchange",
        "description": "The glyph of exchange demotes two metal atoms to their lower opposite-order neighbor, and promotes a third metal atom by 1 metallicity."
      },
      "fluxismus": {
        "": "Glyph of Fluxismus",
        "description": "The glyph of fluxismus transmutes two atoms of quicksilver into one atom of muto and one atom of fixus."
      },
      "servinwheel": {
        "": "Servin's Wheel",
        "description": "By using Servin's wheel with the glyph of Duplication, neutral salt can be turned into any of the ordinals."
      }
    },
