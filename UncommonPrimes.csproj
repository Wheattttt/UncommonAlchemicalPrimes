<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace />
    <AssemblyName>UncommonPrimes</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

	<PropertyGroup>
		<!-- Path to Opus Magnum folder, Contains Lightning.exe et.al -->
		<OpusDir>E:\OMmoddingCE\Opus Magnum\modded</OpusDir>
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>

  <ItemGroup>
    <Reference Include="DevLightning_UAP">
      <HintPath>$(OpusDir)\DevLightning_UAP.dll</HintPath>
      <Private>false</Private>
      <CopyLocal>False</CopyLocal>
    </Reference>
    <Reference Include="Mono.Cecil">
      <HintPath>$(OpusDir)\Mono.Cecil.dll</HintPath>
      <CopyLocal>False</CopyLocal>
    </Reference>
    <Reference Include="MonoMod">
      <HintPath>$(OpusDir)\MonoMod.Patcher.dll</HintPath>
      <CopyLocal>False</CopyLocal>
    </Reference>
    <Reference Include="MonoMod.Utils">
      <HintPath>$(OpusDir)\MonoMod.Utils.dll</HintPath>
      <CopyLocal>False</CopyLocal>
    </Reference>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="copy /Y &quot;$(OpusDir)\Mods\UncommonAlchemicalPrimes\bin\Debug\net10.0\UncommonPrimes.dll&quot; &quot;$(OpusDir)\Mods\UncommonAlchemicalPrimes\UncommonPrimes.dll&quot; &amp;&amp; cd /d &quot;E:\OMmoddingCE\Opus Magnum&quot; &amp;&amp; OpusMutatum.exe" />
  </Target>

</Project>